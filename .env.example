# Copy to .env.local (gitignored) and fill in. Read by Vite (the VITE_* values are
# built into the TV app as defaults) and by the deploy scripts (env.sh).
# One KEY=value per line: no quotes, no inline comments. A variable set on the
# command line (TV=… ./deploy.sh) wins over this file.

# Jellyfin and reel-api (backend/) as the TV reaches them. Also the targets of
# the phone dev server's /jf and /ml proxies. VITE_MEDIALIB_URL defaults to the
# Jellyfin host on port 8790.
VITE_JELLYFIN_URL=http://192.168.1.10:8096
VITE_MEDIALIB_URL=http://192.168.1.10:8790

# The rooted TV (deploy.sh, deploy-service.sh): its address, the root password
# if no ssh key is installed (webosbrew's default is alpine), and its MAC for
# Wake-on-LAN ("Turn on via Wi-Fi" must be enabled; unset = no WoL).
TV=192.168.1.20
#TV_PASS=alpine
#TV_MAC=aa:bb:cc:dd:ee:ff

# phone/deploy.sh: ssh target on the server, the HTTPS origin that serves the
# PWA (with /jf and /ml behind it), and optionally a plain-http LAN origin.
#NAS=user@192.168.1.10
#ORIGIN=https://nas.example.ts.net:9443
#LAN_ORIGIN=http://192.168.1.10:8797
