{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "svelte",
      "vite/client"
    ]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.svelte",
    "src/**/*.d.ts",
    "types/**/*.d.ts",
    "types/tests/tv/**/*.js"
  ],
  "exclude": [
    "src/vendor/libpgs.js"
  ]
}
